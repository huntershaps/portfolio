# Copy this file to .env and fill in values.
# Without SMTP settings the contact form still works locally: the server falls
# back to an Ethereal test inbox and returns a preview link instead of sending.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Address that appears in the 'from' field if SMTP requires it
FROM_ADDRESS=no-reply@example.com

# Where contact form submissions are delivered
CONTACT_TO=hunter@sflinsider.com

# Port the static server listens on (default 8000)
PORT=8000
